# ===== 数据库 =====
DB_PATH=data/stock_cash_streaming.sqlite3

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000

# ===== 目标板块（逗号分隔） =====
TARGET_SECTORS=电网设备,天然气

# ===== LLM（AI 日报）=====
# DeepSeek，OpenAI 兼容接口。官方文档：https://api-docs.deepseek.com/
# 本项目默认从【系统环境变量】读取以下变量；本文件仅为可选的本地覆盖（不提交）。
# 变量命名与系统环境保持一致（OpenAI 兼容约定）：
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ===== DeepSeek 网页搜索（AI 日报的「消息面参考」）=====
# 仅用于日报的定性材料展示（带来源链接），不参与因子/信号/回测
SEARCH_ENABLED=true
SEARCH_COUNT=5
SEARCH_DAYS=7

# ===== 可选：Supabase 远程副本 =====
# SUPABASE_URL=
# SUPABASE_KEY=

# ===== 每日任务调优（小内存云主机必看）=====
# 增量行情并发数与单只超时；2 GB 云主机建议 3~4 / 45
SCS_INCREMENTAL_WORKERS=1
SCS_INCREMENTAL_TIMEOUT=90
# 内存护栏：留空 = 按物理内存 20% 自适应（2 GB → 0.4 GB）；也可显式指定
SCS_MIN_AVAIL_GB=
# 策略研究每日跑批：0 关闭；默认跑「内置池 + 自定义池」，跳过 A0
SCS_DAILY_RESEARCH=1
SCS_DAILY_RESEARCH_MAX_MEMBERS=300
SCS_DAILY_STRATEGIES=defensive,value_quality,residual_momentum,conservative_investment,pead,low_vol_multidim
# ETF(159207) 分析超时（秒）；调度器在 16:40 起最多重试 4 次
SCS_ETF_TIMEOUT=1800
# 池任务是否自己回补落后成员（默认 0：交给每日增量统一处理，避免多池重复抓取）
SCS_POOL_REFETCH_STALE=0

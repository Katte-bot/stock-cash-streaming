# ===== 数据库 =====
DB_PATH=data/stock_cash_streaming.sqlite3

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000

# ===== 目标板块（逗号分隔） =====
TARGET_SECTORS=电网设备,天然气

# ===== LLM（AI 日报）=====
# DeepSeek，OpenAI 兼容接口。官方文档：https://api-docs.deepseek.com/
# 本项目默认从【系统环境变量】读取以下变量；本文件仅为可选的本地覆盖（不提交）。
# 变量命名与系统环境保持一致（OpenAI 兼容约定）：
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ===== DeepSeek 网页搜索（AI 日报的「消息面参考」）=====
# 仅用于日报的定性材料展示（带来源链接），不参与因子/信号/回测
SEARCH_ENABLED=true
SEARCH_COUNT=5
SEARCH_DAYS=7

# ===== 可选：Supabase 远程副本 =====
# SUPABASE_URL=
# SUPABASE_KEY=
